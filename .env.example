# Copy to .env and adjust per environment.

# PostgreSQL connection. Local dev uses the bundled docker-compose Postgres (host port 5433).
DATABASE_URL="postgresql://becatech:becatech@localhost:5433/beca_tech_dashboard?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate. Locally identical to DATABASE_URL.
# On Vercel + Supabase: set DATABASE_URL to the Supavisor TRANSACTION pooler URL (port 6543,
# with ?pgbouncer=true) and DIRECT_URL to the Supavisor SESSION pooler URL (port 5432) — not the
# raw "Direct connection" host, which is IPv6-only and unreachable from Vercel's IPv4-only builds
# unless the Supabase IPv4 add-on is enabled.
DIRECT_URL="postgresql://becatech:becatech@localhost:5433/beca_tech_dashboard?schema=public"

# Supabase Auth (Google sign-in). From the Supabase dashboard: Project Settings > API Keys.
# Leave unset for local dev if you'd rather use DEMO_USER_EMAIL below — see auth section of README.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Local-dev-only auth bypass: which seeded demo user the app acts as instead of requiring a real
# Google sign-in (see prisma/seed.ts demo users). Inert whenever NODE_ENV=production, so this never
# applies on Vercel (Preview or Production) — only under `next dev`.
# Options include: executive@becatech.test, program.manager@becatech.test, mentor1@becatech.test,
# analyst@becatech.test, finance@becatech.test, selection@becatech.test
DEMO_USER_EMAIL="program.manager@becatech.test"

# JotForm integration (placeholder — the MVP does not call the live API).
JOTFORM_API_KEY=""
JOTFORM_WEBHOOK_SECRET=""

# Static, scoped API key for the Google Sheets sync endpoint (POST /api/sync/import), sent by the
# Apps Script bound to the program's master sheet as the `x-api-key` header. Service-to-service
# only — not a user session, and separate from MANAGE_IMPORTS. Generate a long random value and
# set it in Vercel env vars (Production + Preview as needed) and in the Apps Script's Script
# Properties — never hardcode it in the .gs source. See apps-script/README.md.
SHEETS_SYNC_API_KEY=""

# Set to "true" while the automatic 15-minute Google Sheets sync trigger is intentionally paused
# (the trigger's on/off state lives in Apps Script, not the app). When "true", the dashboard's
# data-freshness badge tells users "automatic synchronization is paused". Leave unset/false when
# the trigger is running. Does NOT itself pause or resume the trigger — it's a display flag only.
SYNC_AUTOMATION_PAUSED="true"

# Separate database for integration tests (npm run test:integration). Same Docker Postgres,
# different database name. Created/migrated by the vitest global setup.
TEST_DATABASE_URL="postgresql://becatech:becatech@localhost:5433/beca_tech_test?schema=public"
